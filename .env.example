# Copy this file to .env and replace the password. .env is gitignored.
# The server reads it at start; real environment variables take precedence.
ADMIN_PASSWORD=change-me

# Optional:
# PORT=8765
# BIND=0.0.0.0
# BB_DB=registrations.db
# BB_SECURE_COOKIE=1   # set when the site is served over HTTPS

# Optional: store registrations in Vercel Blob instead of SQLite (what the
# hosted site on Vercel uses). Paste a read-write token from the Blob store.
# BLOB_READ_WRITE_TOKEN=
