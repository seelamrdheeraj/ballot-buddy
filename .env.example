# Copy this file to .env and replace the password. .env is gitignored.
# The server reads it at start; real environment variables take precedence.
ADMIN_PASSWORD=change-me

# Optional:
# PORT=8765
# BIND=0.0.0.0
# BB_DB=registrations.db
# BB_SECURE_COOKIE=1   # set when the site is served over HTTPS
