# Optional. Copy to .env to fix the admin password in advance; otherwise the admin
# page asks you to create one on first visit. Real environment variables take precedence.
# ADMIN_PASSWORD=change-me

# Optional:
# PORT=8765
# BIND=0.0.0.0
# BB_DB=registrations.db
# BB_SECURE_COOKIE=1   # set when the site is served over HTTPS
# SESSION_SECRET=      # signs voter sign-in cookies; if unset, one is generated once and kept in the store

# Optional: store registrations in Vercel Blob instead of SQLite (what the
# hosted site on Vercel uses). Paste a read-write token from the Blob store.
# BLOB_READ_WRITE_TOKEN=
